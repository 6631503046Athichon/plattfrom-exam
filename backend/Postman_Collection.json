{
  "info": {
    "name": "Recipe Sharing Platform API",
    "_postman_id": "recipe-platform-api",
    "description": "API collection for Recipe Sharing Platform - Final Exam Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Get All Recipes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/recipes"
          }
        },
        {
          "name": "Search Recipes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/recipes?search=pasta"
          }
        },
        {
          "name": "Get Recipe by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/recipes/1"
          }
        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/recipes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pad Thai\",\n  \"ingredients\": \"200g rice noodles\\n100g shrimp\\n2 eggs\\n3 tbsp fish sauce\\n2 tbsp tamarind paste\\nBean sprouts\\nPeanuts\",\n  \"instructions\": \"1. Soak noodles in warm water\\n2. Heat oil and scramble eggs\\n3. Add shrimp and cook\\n4. Add noodles and sauce\\n5. Stir-fry until combined\\n6. Top with bean sprouts and peanuts\",\n  \"image_url\": \"https://example.com/padthai.jpg\"\n}"
            }
          }
        },
        {
          "name": "Update Recipe",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/recipes/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Recipe Title\",\n  \"ingredients\": \"Updated ingredients\",\n  \"instructions\": \"Updated instructions\",\n  \"image_url\": \"https://example.com/updated.jpg\"\n}"
            }
          }
        },
        {
          "name": "Delete Recipe",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/recipes/1"
          }
        },
        {
          "name": "Get My Recipes",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/recipes/user/my-recipes"
          }
        }
      ]
    },
    {
      "name": "Ratings",
      "item": [
        {
          "name": "Get Recipe Ratings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/recipes/1/ratings"
          }
        },
        {
          "name": "Add Rating",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/recipes/1/ratings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Absolutely delicious! Easy to follow instructions.\"\n}"
            }
          }
        },
        {
          "name": "Update Rating",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/ratings/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Updated comment\"\n}"
            }
          }
        },
        {
          "name": "Delete Rating",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/ratings/1"
          }
        }
      ]
    }
  ]
}
